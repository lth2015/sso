#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-}" in
 prepare) scripts/api prepare ;;
 up) scripts/api up ;;
 test) node tests/console/browser.cjs ;;
 rbac-test) node tests/rbac/browser.cjs ;;
 playground-test) node tests/playground/browser.cjs ;;
 security-test) node tests/security/browser.cjs ;;
 authenticator-test) node tests/authenticator/browser.cjs ;;
 events-test) node tests/events/browser.cjs ;;
 clients-test) node tests/applications/managed-browser.cjs ;;
 organizations-test) node tests/organizations/browser.cjs ;;
 applications-test) node tests/applications/browser.cjs ;;
 verify-fixture)
  [[ "${2:-}" == '--user' && "${3:-}" =~ ^[a-f0-9]{32}$ ]] || exit 2
  docker compose --env-file .local/m0.env -f deploy/local/compose.yml run --rm --no-deps -e SSO_CONSOLE_TEST=true -e "CONSOLE_TEST_USER=$3" demo-tests -test.v -test.run 'TestConsoleRealTokenIsolationAndExpiryFixture|TestDemoDatabaseRoles'
  ;;
 enable) shift; scripts/api enable "$@" ;;
 down) scripts/sso down ;;
 *) echo 'Usage: scripts/console {prepare|up|test|rbac-test|playground-test|security-test|authenticator-test|events-test|applications-test|organizations-test|clients-test|enable --email ADDRESS|down}' >&2; exit 2 ;;
esac
