#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-}" in
 prepare) scripts/api prepare ;;
 up) scripts/api up ;;
 test) node tests/console/browser.cjs ;;
 rbac-test) node tests/rbac/browser.cjs ;;
 role-choices-test) node tests/role-choices/browser.cjs ;;
 playground-test) node tests/playground/browser.cjs ;;
 security-test) node tests/security/browser.cjs ;;
 authenticator-test) node tests/authenticator/browser.cjs ;;
 events-test) node tests/events/browser.cjs ;;
 audit-client-test) scripts/test-user-audit ;;
 audit-policy-client-test) scripts/test-user-audit policy ;;
 access-history-api-test) node tests/access-history/native.cjs ;;
 access-history-test) node tests/access-history/browser.cjs ;;
 user-access-api-test) node tests/user-access/native.cjs ;;
 user-access-test) scripts/test-user-access ;;
 policy-history-test) node tests/policy-history/browser.cjs ;;
 policy-history-api-test) node tests/policy-history/native.cjs ;;
 protocol-test) node tests/protocol/browser.cjs ;;
 protocol-api-test) node tests/protocol/native.cjs ;;
 invitations-test) node tests/invitations/browser.cjs ;;
 invitations-api-test) node tests/invitations/native.cjs ;;
 exports-test) node tests/exports/browser.cjs ;;
 exports-api-test) node tests/exports/native.cjs ;;
 machine-sdk-test) scripts/test-machine-sdk ;;
 machine-test) node tests/machine/browser.cjs ;;
 machine-api-test) node tests/machine/native.cjs ;;
 clients-test) node tests/applications/managed-browser.cjs ;;
 organizations-test) node tests/organizations/browser.cjs ;;
 organization-hierarchy-test) node tests/organization-hierarchy/browser.cjs ;;
 organization-assignment-test) node tests/organization-assignment/browser.cjs ;;
 applications-test) node tests/applications/browser.cjs ;;
 verify-fixture)
  [[ "${2:-}" == '--user' && "${3:-}" =~ ^[a-f0-9]{32}$ ]] || exit 2
  docker compose --env-file .local/m0.env -f deploy/local/compose.yml run --rm --no-deps -e SSO_CONSOLE_TEST=true -e "CONSOLE_TEST_USER=$3" demo-tests -test.v -test.run 'TestConsoleRealTokenIsolationAndExpiryFixture|TestDemoDatabaseRoles'
  ;;
 enable) shift; scripts/api enable "$@" ;;
 down) scripts/sso down ;;
 *) echo 'Usage: scripts/console {prepare|up|test|rbac-test|role-choices-test|playground-test|security-test|authenticator-test|events-test|applications-test|organizations-test|organization-hierarchy-test|clients-test|organization-assignment-test|machine-test|machine-api-test|machine-sdk-test|exports-test|exports-api-test|invitations-test|invitations-api-test|protocol-test|protocol-api-test|audit-client-test|audit-policy-client-test|user-access-api-test|user-access-test|access-history-api-test|access-history-test|policy-history-test|policy-history-api-test|enable --email ADDRESS|down}' >&2; exit 2 ;;
esac
