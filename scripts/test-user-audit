#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$PWD/.tools/go/bin:$PATH" GOPATH="$PWD/.local/go" GOCACHE="$PWD/.local/go-cache" GOMODCACHE="$PWD/.local/go-mod"
CGO_ENABLED=0 go build -trimpath -o .local/audit-batch-example ./examples/audit-batch
chmod 700 .local/audit-batch-example
node tests/audit/client.cjs
