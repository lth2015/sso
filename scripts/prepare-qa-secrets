#!/usr/bin/env python3
"""One-time administrator preparation; copies live values in memory, never prints them.
Leaves existing ConfigMap data intact until the migration-gated deployment switches references.
"""
import base64
import os
import sys
from qa_release import configure, get, kubectl, load

if sys.argv[1:] not in (['--check'], ['--prepare'], ['--activate']):
    raise SystemExit('Use --check, --prepare or --activate with the administrator QA kubeconfig')
os.environ.setdefault("QA_KUBE_CONTEXT", "gke_netstars-ai-projects-qa_asia-northeast1_qa-gcp-tokyo-ai-gke-latest")
prepare = sys.argv[1:] in (['--prepare'], ['--activate'])
runtime, maps = load()
plans = []
for r in runtime:
    ns, name = r['namespace'], r['deployment']
    dep = get('deployment', name, ns)
    container = next(c for c in dep['spec']['template']['spec']['containers'] if c['name'] == name)
    cm = get('configmap', r['configMap'], ns, missing=True)
    values = dict(cm.get('data', {}) if cm else {})
    values.update({e['name']: e['value'] for e in container.get('env', []) if 'value' in e})
    secret = get('secret', r['secret'], ns)
    additions = {}
    for key in r['secretKeys']:
        current = secret.get('data', {}).get(key)
        desired = base64.b64encode(values[key].encode()).decode() if key in values else None
        if current is not None and desired is not None and current != desired:
            raise SystemExit('Existing Secret differs from live configuration: ' + ns + '/' + name + '/' + key)
        if current is None:
            if desired is None:
                raise SystemExit('Missing required Secret key: ' + ns + '/' + name + '/' + key)
            additions[key] = desired
    plans.append((r, cm, secret, additions))
# Complete validation before writing any Secret.
for r, cm, secret, additions in plans:
    ns = r['namespace']
    if prepare and additions:
        kubectl(['patch', 'secret', r['secret'], '-n', ns, '--type=merge', '--patch-file=/dev/stdin', '-o', 'json'],
                {'metadata': {'resourceVersion': secret['metadata']['resourceVersion']}, 'data': additions})
    if prepare and cm is None:
        kubectl(['create', '-f', '-', '-o', 'json'], maps[(ns, r['configMap'])])
    print(('Prepared' if prepare else 'Checked') + ' runtime Secret references: ' + ns + '/' + r['deployment'])
if sys.argv[1:] == ['--activate']:
    current_maps, refs = {}, {}
    for r in runtime:
        ns, name = r['namespace'], r['deployment']
        current_maps[(ns, r['configMap'])] = get('configmap', r['configMap'], ns)
        dep = get('deployment', name, ns)
        refs[(ns, name)] = next(c['image'] for c in dep['spec']['template']['spec']['containers'] if c['name'] == name)
    configure(runtime, maps, current_maps, refs)
    print('Sensitive configuration moved to Secret references; application images unchanged')
else:
    print('Existing applications and ConfigMap values unchanged; pipeline finalizes after migrations pass')
