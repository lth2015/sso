#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-}" in
 prepare) python3 scripts/generate_public_spec.py --check; python3 scripts/generate_machine_spec.py --check; python3 scripts/generate_machine_example_spec.py --check; python3 scripts/generate_console_spec.py --check; scripts/docs check; scripts/sso prepare ;;
 up) scripts/sso up ;;
 test) python3 scripts/generate_public_spec.py --check; node tests/api/browser.cjs ;;
 verify-race) docker compose --env-file .local/m0.env -f deploy/local/compose.yml run --rm -T --no-deps api-tests ;;
 enable) shift; scripts/sso enable "$@" --application local-platform ;;
 *) echo 'Usage: scripts/api {prepare|up|test|enable --email ADDRESS}' >&2; exit 2 ;;
esac
