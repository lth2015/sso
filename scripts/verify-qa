#!/usr/bin/env python3
"""Read-only HTTP acceptance with a bounded GKE ingress convergence window."""
import http.cookiejar
import time
import urllib.error
import urllib.parse
import urllib.request


def verify():
    for url in ("https://bff.nsstest.com/", "https://sso.nsstest.com/account"):
        with urllib.request.urlopen(url, timeout=15) as response:
            if response.status != 200 or not response.read():
                raise ValueError("Public page check failed")
    opener = urllib.request.build_opener(
        urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
    with opener.open("https://bff.nsstest.com/login", timeout=15) as response:
        target = urllib.parse.urlsplit(response.url)
        if response.status != 200 or target.hostname != "sso.nsstest.com" or target.path != "/login":
            raise ValueError("SSO login redirect target mismatch")
        if not response.read():
            raise ValueError("SSO login page is empty")


deadline = time.monotonic() + 300
consecutive = 0
while True:
    try:
        verify()
        consecutive += 1
        print("QA pages and OAuth redirect verified (%d/3)" % consecutive, flush=True)
        if consecutive == 3:
            break
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as error:
        consecutive = 0
        # Never log callback URLs, authorization codes, cookies or raw response bodies.
        code = getattr(error, "code", None)
        print("Waiting for QA ingress: " + ("HTTP " + str(code) if code else type(error).__name__), flush=True)
    if time.monotonic() >= deadline:
        raise SystemExit("QA acceptance did not become stable within five minutes")
    time.sleep(10)
