#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-}" in
 build|export)
  export npm_config_cache="$PWD/.local/npm-cache"
  npm ci --prefix web/console --no-audit --no-fund
  python3 scripts/generate_handbook.py
  node scripts/render-docs.mjs
  if [[ "$1" == export ]]; then python3 scripts/export_docs.py; fi
  ;;
 check) python3 scripts/generate_handbook.py --check ;;
 verify) node tests/docs/offline.cjs ;;
 *) echo 'Usage: scripts/docs {build|check|export|verify}' >&2; exit 2 ;;
esac
