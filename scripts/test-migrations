#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
container="sso-migration-test-$$"
trap 'docker rm -f "$container" >/dev/null 2>&1 || true' EXIT
docker run -d --rm --name "$container" -p 127.0.0.1::3306 \
  -e MYSQL_ROOT_PASSWORD=local-migration-test-only mysql:8.4 >/dev/null
for attempt in $(seq 1 60); do
  if docker exec -e MYSQL_PWD=local-migration-test-only "$container" mysqladmin --protocol=TCP --host=127.0.0.1 -uroot ping --silent >/dev/null 2>&1; then break; fi
  sleep 1
done
export SSO_MIGRATION_TEST_ADDR="$(docker port "$container" 3306/tcp)"
go test ./internal/dbmigration -count=1 -v
